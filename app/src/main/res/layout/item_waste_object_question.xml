
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="9dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="#E1EEE6"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 객체 목록 제목 : 클릭하면 질문 펼치기 -->
        <LinearLayout
            android:id="@+id/layout_object_header"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <!-- 객체 번호 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="38dp"
                android:layout_height="38dp"
                app:cardBackgroundColor="@color/bg_green_light"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <TextView
                    android:id="@+id/tv_object_number"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="@color/primary_green"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </com.google.android.material.card.MaterialCardView>

            <!-- 객체 종류 및 신뢰도 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_object_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="플라스틱"
                    android:textColor="@color/text_main"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_object_confidence"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="AI 신뢰도 88.87%"
                    android:textColor="@color/text_sub"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- 답변 상태 -->
            <TextView
                android:id="@+id/tv_object_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="미입력"
                android:textColor="@color/primary_green"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- 펼치기 표시 -->
            <TextView
                android:id="@+id/tv_object_expand_indicator"
                android:layout_width="30dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="⌄"
                android:textColor="@color/text_sub"
                android:textSize="20sp" />

        </LinearLayout>

        <!-- 객체별 질문 영역 : 기본적으로 접혀 있음 -->
        <LinearLayout
            android:id="@+id/layout_object_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="4dp"
            android:paddingBottom="16dp"
            android:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E1EEE6" />

            <!-- 첫 번째 질문 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/question_contamination"
                android:textColor="@color/text_main"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="@color/bg_green_light"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <RadioGroup
                    android:id="@+id/rg_object_contamination"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rb_object_contamination_yes"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackground"
                        android:buttonTint="@color/primary_green"
                        android:gravity="center_vertical"
                        android:paddingStart="6dp"
                        android:text="@string/answer_yes"
                        android:textColor="@color/text_main"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="22dp"
                        android:background="#D5E5DB" />

                    <RadioButton
                        android:id="@+id/rb_object_contamination_no"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackground"
                        android:buttonTint="@color/primary_green"
                        android:gravity="center_vertical"
                        android:paddingStart="6dp"
                        android:text="@string/answer_no"
                        android:textColor="@color/text_main"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </RadioGroup>

            </com.google.android.material.card.MaterialCardView>

            <!-- 두 번째 질문 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/question_remaining_contents"
                android:textColor="@color/text_main"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="@color/bg_green_light"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <RadioGroup
                    android:id="@+id/rg_object_remaining"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rb_object_remaining_yes"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackground"
                        android:buttonTint="@color/primary_green"
                        android:gravity="center_vertical"
                        android:paddingStart="6dp"
                        android:text="@string/answer_yes"
                        android:textColor="@color/text_main"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="22dp"
                        android:background="#D5E5DB" />

                    <RadioButton
                        android:id="@+id/rb_object_remaining_no"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackground"
                        android:buttonTint="@color/primary_green"
                        android:gravity="center_vertical"
                        android:paddingStart="6dp"
                        android:text="@string/answer_no"
                        android:textColor="@color/text_main"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </RadioGroup>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
